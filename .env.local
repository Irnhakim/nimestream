# Masukkan domain Otakudesu baru di bawah ini jika domain lama diblokir/berubah.
# Contoh: https://otakudesu.ltd atau https://otakudesu.cloud
NEXT_PUBLIC_OTAKUDESU_URL=https://otakudesu.blog

# Konfigurasi Kusonime (Opsional)
# Ubah KUSONIME_ENABLED ke false jika ingin menonaktifkan fitur Kusonime sepenuhnya
NEXT_PUBLIC_KUSONIME_ENABLED=true
NEXT_PUBLIC_KUSONIME_URL=https://kusonime.com

# Konfigurasi Oploverz (Opsional)
# Ubah ke false jika ingin menonaktifkan fitur scraper Oploverz sepenuhnya
NEXT_PUBLIC_OPLOVERZ_ENABLED=false
NEXT_PUBLIC_OPLOVERZ_API_URL=https://backapi.oploverz.ac/api

# Konfigurasi Alqanime (Opsional)
# Ubah ke false jika ingin menonaktifkan fitur scraper Alqanime sepenuhnya (karena potensi pemblokiran WAF/Warp/OpenResty)
NEXT_PUBLIC_ALQANIME_ENABLED=
NEXT_PUBLIC_ALQANIME_URL=https://alqanime.net

# --- MULTI-SOURCE SCRAPER CONFIGURATION ---
# Default disable untuk meminimalkan beban CPU/Network, aktifkan manual sesuai kebutuhan
NEXT_PUBLIC_DONGHUA_ENABLED=true
NEXT_PUBLIC_DONGHUA_URL=https://anichin.cafe

NEXT_PUBLIC_SAMEHADAKU_ENABLED=true
NEXT_PUBLIC_SAMEHADAKU_URL=https://v1.samehadaku.how

NEXT_PUBLIC_ANIMASU_ENABLED=true
NEXT_PUBLIC_ANIMASU_URL=https://v1.animasu.top

NEXT_PUBLIC_ZORONIME_ENABLED=true
NEXT_PUBLIC_ZORONIME_URL=https://zoronime.com

NEXT_PUBLIC_ANOBOY_ENABLED=true
NEXT_PUBLIC_ANOBOY_URL=https://anoboy.be

NEXT_PUBLIC_NIMEGAMI_ENABLED=true
NEXT_PUBLIC_NIMEGAMI_URL=https://nimegami.id

NEXT_PUBLIC_ANIMEINDO_ENABLED=true
NEXT_PUBLIC_ANIMEINDO_URL=https://animeindo.lol

NEXT_PUBLIC_ANIMEKUINDO_ENABLED=true
NEXT_PUBLIC_ANIMEKUINDO_URL=https://animekuindo.live

NEXT_PUBLIC_WINBU_ENABLED=true
NEXT_PUBLIC_WINBU_URL=https://winbu.net

NEXT_PUBLIC_KURAMANIME_ENABLED=true
NEXT_PUBLIC_KURAMANIME_URL=https://v10.kuramanime.tel

NEXT_PUBLIC_ANIMEKOMPI_ENABLED=true
NEXT_PUBLIC_ANIMEKOMPI_URL=https://v7.animekompi.sbs

NEXT_PUBLIC_DONGHUB_ENABLED=true
NEXT_PUBLIC_DONGHUB_URL=https://donghub.vip

NEXT_PUBLIC_DRAMABOX_ENABLED=true
NEXT_PUBLIC_DRAMABOX_URL=https://www.dramabox.com

